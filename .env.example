# ragpilot-bff configuration
# Local SQLite by default (zero-config). Swap DATABASE_URL for PostgreSQL in prod.
DATABASE_URL="file:./dev.db"

# JWT auth (dev token). Override in real deploys.
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="1h"

# Optional: if set, the QueryService proxies to a running ragpilot instance
# instead of using the local Prisma retriever.
RAGPILOT_URL=""

PORT=3000
